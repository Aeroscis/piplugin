@PACKAGE_INIT@

# 包含组件 config（piplugin）
include("${CMAKE_CURRENT_LIST_DIR}/pipluginConfig.cmake")

# -------------- 可选组件：host kits（宿主侧机制库） --------------
include(CMakeFindDependencyMacro)

# L0 会话库（无第三方依赖）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pipluginHostCoreTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/pipluginHostCoreTargets.cmake")
endif()

# L1 DX11 嵌入胶水（仅 Windows，无第三方依赖）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pipluginHostDx11Targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/pipluginHostDx11Targets.cmake")
endif()

# L1 Qt 嵌入区域（依赖 L0 + 本地安装的 Qt5，经 CMAKE_PREFIX_PATH 查找；
# 须在 HostCore 之后 include，因为它 link 到 pi::piplugin_host）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pipluginHostQtTargets.cmake")
    find_dependency(Qt5 COMPONENTS Widgets Core)
    include("${CMAKE_CURRENT_LIST_DIR}/pipluginHostQtTargets.cmake")
endif()

# -------------- 可选组件：adapter kits（安装树里存在才包含，各自先解决第三方依赖） --------------

# imgui adapter kit（依赖 conan imgui；未安装该 kit 时自动跳过）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pipluginImguiAdapterTargets.cmake")
    find_dependency(imgui)
    include("${CMAKE_CURRENT_LIST_DIR}/pipluginImguiAdapterTargets.cmake")
endif()

# qt adapter kit（依赖本地安装的 Qt5，经 CMAKE_PREFIX_PATH 查找；未安装该 kit 时自动跳过）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pipluginQtAdapterTargets.cmake")
    find_dependency(Qt5 COMPONENTS Widgets Core)
    include("${CMAKE_CURRENT_LIST_DIR}/pipluginQtAdapterTargets.cmake")
endif()

check_required_components(pi)